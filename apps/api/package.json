{
  "name": "@spova/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "echo \"(lint) api: skipped in phase 0\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "test:e2e": "tsx --test --test-concurrency=1 test/phase2.e2e.ts test/phase3.e2e.ts test/payments-card.e2e.ts",
    "test:e2e:trading": "tsx --test test/phase3.e2e.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/platform-socket.io": "^11.1.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/websockets": "^11.1.0",
    "@prisma/client": "~6.19.0",
    "@spova/shared": "workspace:*",
    "argon2": "^0.44.0",
    "cookie": "^1.0.2",
    "cookie-parser": "^1.4.7",
    "decimal.js": "^10.5.0",
    "dotenv": "^16.5.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.0",
    "multer": "^2.0.0",
    "nestjs-pino": "^4.4.0",
    "nodemailer": "^10.1.0",
    "pdfkit": "0.15.1",
    "pino-http": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^4.6.0",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "stripe": "17.7.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.19.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "0.13.9",
    "pino-pretty": "^13.0.0",
    "prisma": "~6.19.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3"
  }
}
