# ---------- brand / domain ----------
# Placeholder until the real domain is confirmed. Used in emails, titles, cookie domain.
BRAND_NAME=XYZ
APP_DOMAIN=xyz.local
NEXT_PUBLIC_BRAND_NAME=XYZ

# ---------- api ----------
API_PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://spova:spova@localhost:5432/spova?schema=public
REDIS_URL=redis://localhost:6379
WEB_ORIGIN=http://localhost:3000
# empty in dev (localhost). In prod: .xyz.com
COOKIE_DOMAIN=
COOKIE_SECURE=false

# generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=dev-access-secret-change-me-dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

DEMO_START_BALANCE=10000
DEMO_DEFAULT_LEVERAGE=100

# mail: console (dev, prints link to api log) | resend
MAIL_PROVIDER=console
RESEND_API_KEY=
MAIL_FROM=no-reply@xyz.local
# back-office inbox for new KYC / payment / ticket alerts (empty = no mail)
ADMIN_NOTIFY_EMAIL=

# ---------- files (KYC documents) ----------
# local: writes under infra/data/uploads (git-ignored) - dev only.  s3: Cloudflare R2 / any S3 endpoint, private bucket.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=infra/data/uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=kyc
R2_ENDPOINT=
# KYC gates (true/false)
KYC_REQUIRED_FOR_LIVE=true
KYC_REQUIRED_FOR_WITHDRAW=true

# first superadmin created by `pnpm db:seed`; change after first login
SEED_ADMIN_EMAIL=admin@xyz.local
SEED_ADMIN_PASSWORD=Admin@12345

# ---------- trading (phase 3) ----------
# shared secret between the worker and the API internal endpoints: openssl rand -hex 24
INTERNAL_TOKEN=change-me-internal-token-change-me
# worker feeds: Binance bookTicker for crypto (free, no key), synthetic random walk for everything else until a paid FX feed exists
FEED_BINANCE=on
FEED_SYNTHETIC=on
API_URL=http://localhost:4000

# ---------- web ----------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000
